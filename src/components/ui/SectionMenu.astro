---
import CloudinaryImage from './CloudinaryImage.astro';
// Treść sekcji edytowana w CMS: Strona główna → Sekcja „Tego musisz spróbować”.
import homeMenu from '../../data/home-menu.json';

interface Dish {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  title?: string;
  dishes?: Dish[];
}

const {
  title = homeMenu.title,
  dishes = homeMenu.dishes as Dish[],
} = Astro.props;
---

<section class="section-py">
  <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="section-heading mb-20">
      {title}
    </h2>

    <div class="space-y-6">
      {dishes.map(({ title: dishTitle, description, image, imageAlt = '' }, index) => {
        // Co drugie danie ze zdjęciem po lewej stronie.
        const reverse = index % 2 === 1;

        return (
          <div class="pt-20 pb-10 lg:pt-10 px-10 max-w-xl lg:max-w-none mx-auto border border-glass-border rounded-3xl shadow-xl shadow-black/40">
            <div class:list={['flex flex-wrap -mx-4 items-center', reverse ? 'flex-row-reverse' : '']}>

              <div class="w-full lg:w-7/12 px-4 mb-12 lg:mb-0">
                <div class="max-w-sm xl:max-w-lg mx-auto">
                  <h3 class="text-4xl tracking-tight mb-6 text-glass-white">{dishTitle}</h3>
                  <p class="prose-p max-w-md">{description}</p>
                </div>
              </div>

              <div class="w-full lg:w-5/12">
                {image ? (
                  <div class="relative rounded-3xl overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-t from-glass-accent-amber/30 via-transparent to-glass-black/20 pointer-events-none"></div>
                    <CloudinaryImage publicId={image} alt={imageAlt} preset="section" class="block w-full rounded-3xl" />
                  </div>
                ) : (
                  <CloudinaryImage alt={imageAlt} preset="section" placeholderClass="rounded-3xl" />
                )}
              </div>

            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

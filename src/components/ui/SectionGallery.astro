---
import { getCollection } from 'astro:content';
import { cloudinaryThumbUrl } from '../../utils/cloudinary';

interface Props {
  title?: string;
  initialCount?: number;
  step?: number;
  moreLabel?: string;
  perCategory?: number;
}

const {
  title = 'Zajrzyj do Riverside',
  initialCount = 3,
  step = 3,
  moreLabel = 'Pokaż więcej zdjęć',
  perCategory = 5,
} = Astro.props;

const entries = await getCollection('gallery', (e) => e.data.published);
const sorted = [...entries].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const items = sorted.flatMap((e) =>
  (e.data.media ?? [])
    .filter((m) => m.file)
    .slice(0, perCategory)
    .map((m) => ({
      title: e.data.title,
      thumb: cloudinaryThumbUrl(m.file, { width: 900, aspectRatio: '4:3', crop: 'fill' }),
      alt: m.alt || e.data.title,
    })),
);

const hero = items[0];
const rest = items.slice(1);
---

{hero && (
  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-16">{title}</h2>

      <div class="mb-8 rounded-3xl overflow-hidden shadow-2xl shadow-black/40 ring-1 ring-glass-border">
        <img
          class="block w-full h-112 sm:h-135 object-cover"
          src={hero.thumb}
          alt={hero.alt}
          loading="lazy"
          decoding="async"
        />
      </div>

      {rest.length > 0 && (
        <div
          x-data={`{
            visible: ${initialCount},
            step: ${step},
            total: ${rest.length},
            showMore() { this.visible = Math.min(this.visible + this.step, this.total) }
          }`}
        >
          <div class="flex flex-wrap -mx-4">
            {rest.map((item, i) => (
              <div class="w-full md:w-1/2 xl:w-1/3 px-4 mb-8" x-show={`${i} < visible`}>
                <div class="relative rounded-3xl overflow-hidden shadow-xl shadow-black/40 ring-1 ring-glass-border">
                  <img
                    class="block w-full h-80 object-cover"
                    src={item.thumb}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            ))}
          </div>

          <div class="flex justify-center" x-show="visible < total">
            <button
              type="button"
              x-on:click="showMore()"
              class="inline-flex py-5 px-8 font-medium text-glass-white hover:text-glass-black leading-none items-center justify-center border border-glass-border hover:bg-glass-accent-fire hover:border-glass-accent-fire rounded-full transition-colors duration-150"
            >
              <span class="mr-2.5">{moreLabel}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5v11.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L7.5 13.293V1.5A.5.5 0 0 1 8 1z"/>
              </svg>
            </button>
          </div>
        </div>
      )}
    </div>
  </section>
)}

---
import CloudinaryImage from './CloudinaryImage.astro';
import { withBase } from '../../config/site';

interface Props {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = 'Planujesz imprezę?',
  subtitle = 'Zorganizuj ją w Riverside - dopniemy wszystko od menu po oprawę.',
  ctaLabel = 'Poznaj szczegóły oferty',
  ctaHref = '/events',
  image = 'riverside-dym-ogien-gdansk-chef-michal-rybak',
  imageAlt = 'Chef Michał Rybak',
} = Astro.props;

---

<section class="section-py md:pb-0 overflow-hidden">
  <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="px-0 sm:px-6 md:px-12">
      <div class="relative max-w-5xl mx-auto">

        <CloudinaryImage
          publicId={image}
          alt={imageAlt}
          preset="portrait"
          class="hidden lg:block absolute bottom-0 right-0 lg:w-5/12 xl:w-96 z-10"
          placeholderClass="hidden lg:flex absolute bottom-0 right-0 lg:w-5/12 xl:w-96 z-10 rounded-2xl"
        />

        <div class="relative pt-12 md:pt-24 md:pb-36 xl:pt-36 lg:max-w-3xl">
          <div class="max-w-sm sm:max-w-none">
            <h2 class="section-heading relative z-10 mb-14">
              {title}
            </h2>
            <p class="inline-block text-2xl sm:text-3xl leading-tight mb-10 text-glass-muted">
              {subtitle}
            </p>
          </div>

          <CloudinaryImage
            publicId={image}
            alt={imageAlt}
            preset="portrait"
            class="block mb-8 max-w-xs lg:hidden rounded-2xl shadow-2xl shadow-black/50 ring-1 ring-glass-border"
            placeholderClass="flex mb-8 max-w-xs lg:hidden rounded-2xl"
          />

          <div class="relative z-10 flex flex-col sm:flex-row flex-wrap">
            <a
              href={withBase(ctaHref)}
              class="group inline-flex py-5 px-8 font-medium text-glass-white leading-none items-center justify-center bg-glass-accent-amber hover:bg-glass-accent-glow rounded-full transition-colors duration-150"
            >
              <span class="mr-2.5">{ctaLabel}</span>
              <span class="group-hover:rotate-45 transform transition duration-75">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                  <path fill-rule="evenodd" d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0v-6z"/>
                </svg>
              </span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

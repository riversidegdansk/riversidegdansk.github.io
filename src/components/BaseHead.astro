---
import { SITE, CONTACT, BUSINESS, MEDIA, SAME_AS, CHEF, RESTAURANT, NAV, FOOTER_NAV, withBase } from '../config/site';
import { cloudinaryUrl } from '../utils/cloudinary';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title?:       string;
  description?: string;
  ogImage?:     string;
  ogType?:      'website' | 'article';
  canonical?:   string;
  noindex?:     boolean;
  jsonLd?:      object | object[];
  article?:     { publishedTime: string; modifiedTime?: string };
  breadcrumbs?: Crumb[];
}

const {
  title,
  description: rawDescription,
  ogImage     = SITE.ogImage,
  ogType      = 'website',
  canonical,
  noindex     = false,
  jsonLd,
  article,
  breadcrumbs,
} = Astro.props;

const description = rawDescription?.trim() ? rawDescription : SITE.description;

const pageTitle = title
  ? `${title} | ${SITE.name}`
  : `${SITE.name} | Restauracja nad Motławą w Gdańsku`;
const pageUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const path    = Astro.url.pathname;
const is404   = path.startsWith('/404');

const ORG_ID  = `${SITE.finalUrl}/#organization`;
const CHEF_ID = `${SITE.finalUrl}/#michal-rybak`;

const orgJsonLd = {
  '@context':         'https://schema.org',
  '@type':            BUSINESS.type,
  '@id':              ORG_ID,
  name:               SITE.fullName,
  alternateName:      SITE.alternateName,
  url:                `${SITE.finalUrl}/`,
  logo: {
    '@type': 'ImageObject',
    url:     `${SITE.finalUrl}${MEDIA.favicon.icon512}`,
    width:   512,
    height:  512,
  },
  image: [
    SITE.ogImage,
    ...RESTAURANT.images.map((id) => cloudinaryUrl(id, { width: 1200, aspectRatio: '4:3', crop: 'fill' })),
  ],
  description:        SITE.description,
  telephone:          CONTACT.phone,
  email:              CONTACT.email,
  address: {
    '@type':          'PostalAddress',
    streetAddress:    CONTACT.address,
    postalCode:       CONTACT.postalCode,
    addressLocality:  CONTACT.locality,
    addressRegion:    CONTACT.region,
    addressCountry:   CONTACT.country,
  },
  geo: {
    '@type':    'GeoCoordinates',
    latitude:   CONTACT.lat,
    longitude:  CONTACT.lng,
  },
  openingHoursSpecification: CONTACT.openingHoursSpecification,
  servesCuisine:       RESTAURANT.servesCuisine,
  hasMenu:             `${SITE.finalUrl}/menu/`,
  acceptsReservations: CONTACT.reservationUrl,
  hasMap:              CONTACT.mapsUrl,
  sameAs:              SAME_AS,
  employee:            { '@id': CHEF_ID },
  currenciesAccepted:  BUSINESS.currenciesAccepted,
  paymentAccepted:     BUSINESS.paymentAccepted,
  areaServed: {
    '@type': 'City',
    name:    BUSINESS.areaServed,
  },
  priceRange:          BUSINESS.priceRange,
};

// Szef kuchni jako osoba — autor przepisów i twarz kuchni (E-E-A-T, GEO).
const chefJsonLd = {
  '@context': 'https://schema.org',
  '@type':    'Person',
  '@id':      CHEF_ID,
  name:       CHEF.name,
  jobTitle:   CHEF.jobTitle,
  image:      cloudinaryUrl(CHEF.image, { width: 600 }),
  url:        `${SITE.finalUrl}${CHEF.url}`,
  worksFor:   { '@id': ORG_ID },
  sameAs:     CHEF.sameAs,
};

const websiteJsonLd = {
  '@context':  'https://schema.org',
  '@type':     'WebSite',
  '@id':       `${SITE.finalUrl}/#website`,
  url:         `${SITE.finalUrl}/`,
  name:        SITE.name,
  description: SITE.description,
  inLanguage:  'pl-PL',
  publisher: {
    '@id': ORG_ID,
  },
};

// Okruszki: Start › (Riverside od Kuchni ›) strona. Nazwy z menu, w razie braku — tytuł strony.
const navLabel = (href: string) =>
  [...NAV, ...FOOTER_NAV].find((item) => withBase(item.href) === href)?.label;
const autoCrumbs: Crumb[] = (() => {
  if (path === '/' || noindex || is404) return [];
  const list: Crumb[] = [{ name: 'Start', path: '/' }];
  if (path.startsWith('/posts/') && path !== '/posts/') {
    list.push({ name: navLabel('/posts/') ?? 'Blog', path: '/posts/' });
  }
  list.push({ name: navLabel(path) ?? title ?? SITE.name, path });
  return list;
})();
const crumbs = breadcrumbs ?? autoCrumbs;
const breadcrumbJsonLd = crumbs.length > 1 ? {
  '@context': 'https://schema.org',
  '@type':    'BreadcrumbList',
  itemListElement: crumbs.map((crumb, i) => ({
    '@type':  'ListItem',
    position: i + 1,
    name:     crumb.name,
    item:     new URL(crumb.path, SITE.url).href,
  })),
} : null;

const allJsonLd = [
  orgJsonLd,
  chefJsonLd,
  websiteJsonLd,
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{pageTitle}</title>
<meta name="description" content={description}>
{!is404 && <link rel="canonical" href={pageUrl}>}
{noindex && <meta name="robots" content="noindex, follow">}

<meta property="og:type"         content={ogType}>
<meta property="og:url"          content={pageUrl}>
<meta property="og:title"        content={pageTitle}>
<meta property="og:description"  content={description}>
<meta property="og:image"        content={ogImage}>
<meta property="og:image:width"  content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt"    content={pageTitle}>
<meta property="og:locale"       content={SITE.locale}>
<meta property="og:site_name"    content={SITE.name}>
{article && <meta property="article:published_time" content={article.publishedTime}>}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime}>}

<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:title"       content={pageTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image"       content={ogImage}>
<meta name="twitter:image:alt" content={pageTitle}>

<link rel="icon"             href={withBase(MEDIA.favicon.ico)}           sizes="32x32">
<link rel="icon"             href={withBase(MEDIA.favicon.svg)}           type="image/svg+xml">
<link rel="apple-touch-icon" href={withBase(MEDIA.favicon.appleTouchIcon)}>
<link rel="manifest"         href={withBase(MEDIA.favicon.manifest)}>
<meta name="theme-color"     content={SITE.themeColor}>
<meta name="msapplication-TileColor" content={SITE.bgColor}>
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Riverside">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://res.cloudinary.com">

{allJsonLd.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 0)} />
))}
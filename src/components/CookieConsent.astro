---
---
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css"/>

<script type="module">
import * as CookieConsent from 'https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.esm.js';

window.CookieConsent = CookieConsent;

// Cookies do usunięcia po odmowie lub wycofaniu zgody. Każda nazwa dwa razy:
// bez domeny (cookie hosta) i z domeną główną (GA i Meta zapisują na .riversidegdansk.pl).
const clear = (...names) => names.flatMap((name) => [{ name }, { name, domain: 'riversidegdansk.pl' }]);

window.addEventListener('load', () => {
  CookieConsent.run({
    // Wersja zasad zgody. Zgoda z inną wersją (w tym ze starej strony, wersja 0) jest nieważna
    // i okno pojawia się ponownie. Zwiększ przy zmianie usług, np. po dodaniu TikToka.
    revision: 1,
    guiOptions: {
      consentModal: {
        layout: 'box',
        position: 'bottom left',
        equalWeightButtons: false,
        flipButtons: false,
      },
      preferencesModal: {
        layout: 'box',
        position: 'right',
        equalWeightButtons: true,
        flipButtons: false,
      },
    },
    categories: {
      necessary: {
        readOnly: true,
        services: {
          cc_cookie: { label: 'Zgoda na cookies (cc_cookie)' },
          gtranslate: { label: 'GTranslate' },
        },
      },
      functional: {},
      analytics: {
        autoClear: { cookies: clear(/^_ga/, '_gid') },
        services: {
          ga: { label: 'Google Analytics' },
          gtm: { label: 'Google Tag Manager' },
        },
      },
      marketing: {
        autoClear: { cookies: clear('_fbp', '_fbc') },
        services: {
          meta: { label: 'Meta Pixel (Facebook, Instagram)' },
        },
      },
    },
    language: {
      default: 'pl',
      translations: {
        pl: {
          consentModal: {
            title: 'Używamy plików cookies',
            description: 'Ta strona używa plików cookies niezbędnych do jej działania oraz — po Twojej zgodzie — funkcjonalnych, analitycznych i marketingowych. Możesz zaakceptować wszystkie lub wybrać które kategorie akceptujesz.',
            acceptAllBtn: 'Akceptuj wszystkie',
            acceptNecessaryBtn: 'Tylko niezbędne',
            showPreferencesBtn: 'Zarządzaj preferencjami',
          },
          preferencesModal: {
            title: 'Preferencje cookies',
            acceptAllBtn: 'Akceptuj wszystkie',
            acceptNecessaryBtn: 'Tylko niezbędne',
            savePreferencesBtn: 'Zapisz preferencje',
            closeIconLabel: 'Zamknij',
            serviceCounterLabel: 'Usługa|Usługi',
            sections: [
              {
                title: 'Niezbędne cookies (zawsze aktywne)',
                description: 'Wymagane do prawidłowego i bezpiecznego funkcjonowania strony, w tym przełącznika języka (GTranslate). Nie można ich wyłączyć.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Funkcjonalne cookies',
                description: 'Umożliwiają korzystanie z dodatkowych funkcji strony, np. osadzonych usług zewnętrznych.',
                linkedCategory: 'functional',
              },
              {
                title: 'Analityczne cookies',
                description: 'Pomagają nam zrozumieć jak użytkownicy korzystają ze strony (Google Analytics, Google Tag Manager).',
                linkedCategory: 'analytics',
              },
              {
                title: 'Marketingowe cookies',
                description: 'Służą do pomiaru skuteczności reklam, remarketingu i dopasowywania reklam do zainteresowań (np. Meta Pixel).',
                linkedCategory: 'marketing',
              },
            ],
          },
        },
      },
    },
  });
});
</script>
---
// Formularz zapytania o imprezę (Formspark: PUBLIC_FORMSPARK_EVENTS_FORM_ID — osobny od kontaktowego).
// Pola mają ID z prefiksem, więc formularz można osadzić obok innego na tej samej stronie.
import { CONTACT, FORMSPARK, TURNSTILE } from '../../config/site';

interface Props {
  idPrefix?:    string;
  eventTypes?:  string[];
  minGuests?:   number;
  submitLabel?: string;
  emailSubject?: string;
}

const {
  idPrefix    = 'event',
  eventTypes  = [
    'Urodziny',
    'Wesele',
    'Komunia / Chrzciny',
    'Jubileusz',
    'Impreza firmowa',
    'Integracja firmowa',
    'Kolacja biznesowa',
    'Szkolenie / Konferencja',
    'Inna okazja',
  ],
  minGuests   = 10,
  emailSubject = 'Masz nowe zapytanie w sprawie imprezy z riversidegdansk.pl',
  submitLabel = 'Wyślij zapytanie',
} = Astro.props;

const formAction = `${FORMSPARK.url}/${FORMSPARK.eventsFormId}`;
const id = (name: string) => `${idPrefix}-${name}`;
---

<form
  action={formAction}
  method="POST"
  x-data="{ sending: false, sent: false, error: false }"
  x-init="$refs.date.min = new Date().toISOString().slice(0, 10)"
  x-on:submit.prevent="
    sending = true;
    fetch($el.action, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: (() => {
        // Ustawienia _email.* wysyłamy płasko i jako obiekt — Formspark przy JSON-ie może oczekiwać obu form.
        const data = Object.fromEntries(new FormData($el));
        data._email = { subject: data['_email.subject'], from: data['_email.from'] };
        return JSON.stringify(data);
      })()
    })
      .then(r => { sent = r.ok; error = !r.ok; })
      .catch(() => { error = true; })
      .finally(() => { sending = false; })
  "
>
  <input type="hidden" name="_redirect" value="false" />
  {/* Ustawienia e-maila z powiadomieniem (Formspark). „Odpowiedz” trafia do klienta dzięki polu name="email" (type="email"). */}
  <input type="hidden" name="_email.subject" value={emailSubject} />
  <input type="hidden" name="_email.from" value="Riverside Dym i Ogień" />
  <div style="display:none" aria-hidden="true">
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <label for={id('name')} class="sr-only">Imię</label>
  <input id={id('name')} type="text" name="name" placeholder="Imię" required autocomplete="given-name" class="form-input mb-4" />

  <label for={id('company')} class="sr-only">Firma</label>
  <input id={id('company')} type="text" name="company" placeholder="Firma (opcjonalnie)" autocomplete="organization" class="form-input mb-4" />

  <label for={id('phone')} class="sr-only">Telefon</label>
  <input id={id('phone')} type="tel" name="phone" placeholder="Telefon" required autocomplete="tel" class="form-input mb-4" />

  <label for={id('email')} class="sr-only">E-mail</label>
  <input id={id('email')} type="email" name="email" placeholder="E-mail" required autocomplete="email" class="form-input mb-4" />

  <label for={id('type')} class="sr-only">Rodzaj imprezy</label>
  <select id={id('type')} name="event_type" required class="form-input mb-4">
    <option value="" disabled selected>Rodzaj imprezy</option>
    {eventTypes.map((type) => <option value={type}>{type}</option>)}
  </select>

  <label for={id('guests')} class="sr-only">Liczba osób</label>
  <input id={id('guests')} type="number" name="guests" placeholder="Liczba osób" min={minGuests} required class="form-input mb-4" />

  <label for={id('date')} class="sr-only">Termin imprezy</label>
  {/* Pole daty nie obsługuje placeholdera — startuje jako tekst „Data imprezy”, po kliknięciu staje się kalendarzem. */}
  <input
    id={id('date')}
    type="text"
    name="event_date"
    placeholder="Data imprezy"
    x-ref="date"
    x-on:focus="$el.type = 'date'; try { $el.showPicker() } catch (e) {}"
    x-on:blur="if (!$el.value) $el.type = 'text'"
    required
    class="form-input mb-4"
  />

  <div class="cf-turnstile my-8" data-sitekey={TURNSTILE.siteKey}></div>

  <div x-show="sent" style="display: none" role="status" class="mb-4 p-4 rounded-lg border border-glass-accent-cool/30 bg-glass-accent-cool/10 text-glass-accent-cool text-sm">
    Dziękujemy. Zgłoszenie zostało poprawnie wysłane! Skontaktujemy się w ciągu 24h w dni robocze, aby potwierdzić termin.
  </div>
  <div x-show="error" style="display: none" role="alert" class="mb-4 p-4 rounded-lg border border-glass-accent-fire/30 bg-glass-accent-fire/10 text-glass-accent-fire text-sm">
    Coś poszło nie tak. Spróbuj ponownie, zadzwoń: {CONTACT.phoneEvents} albo napisz na {CONTACT.email}.
  </div>

  <button
    type="submit"
    class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-glass-black bg-glass-white hover:bg-glass-white/90 rounded-full transition-all duration-200 hover:shadow-lg group disabled:opacity-50"
    x-bind:disabled="sending || sent"
  >
    <span x-text={`sending ? 'Wysyłanie…' : ${JSON.stringify(submitLabel)}`}>{submitLabel}</span>
    <svg class="ml-2 w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </button>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionSlider from '../components/ui/SectionSlider.astro';
import SectionMenu from '../components/ui/SectionMenu.astro';
import SectionTank from '../components/ui/SectionTank.astro';
import SectionPosts from '../components/ui/SectionPosts.astro';
import SectionReviews from '../components/ui/SectionReviews.astro';
import SectionGmap from '../components/ui/SectionGmap.astro';
import SectionEvents from '../components/ui/SectionEvents.astro';
---

<BaseLayout
  title="Restauracja nad Motławą w Gdańsku"
  description="Restauracja nad Motławą w Gdańsku od 2019 roku. 12-godzinna golonka, żeberka BBQ, pizza i Pilsner Urquell prosto z tanka. Taras z widokiem na Żuraw."
>
  <SectionSlider />
  <SectionMenu />
  <SectionTank />
  <SectionPosts />
  <SectionReviews />
  <SectionGmap />
  <SectionEvents />
</BaseLayout>

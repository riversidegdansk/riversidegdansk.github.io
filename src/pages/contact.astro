---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, SITE, withBase } from '../config/site';
import ContactForm from '../components/forms/ContactForm.astro';
import MapEmbed from '../components/ui/MapEmbed.astro';
---

<BaseLayout
  title="Kontakt i dojazd — ul. Chmielna 10"
  description="Skontaktuj się z Riverside. Dym i Ogień — restauracją nad Motławą w Gdańsku. Sprawdź adres, dane kontaktowe, mapę dojazdu i wyślij wiadomość."
>

  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-start -mx-4">

        <div class="w-full lg:w-1/2 px-4 mb-12 lg:mb-0">
          <h1 class="mb-8 section-heading">Gdzie nas znajdziesz?</h1>
          <p class="prose-p">
            Znajdziesz nas w Gdańsku na Wyspie Spichrzów, nad Motławą, <a href={withBase('/posts/10-wyspa-spichrzow-i-motlawa/')}>tuż za Zieloną Bramą</a>. Kliknij <em>Zobacz trasę</em>, aby sprawdzić, jak do nas dojechać.
          </p>
          <p class="prose-p">
            Chcesz od razu zająć stolik? <a href={withBase('/reservations')}>Zarezerwuj go online</a>. Odpowiedzi na pytania o godziny, taras czy psy znajdziesz w <a href={withBase('/faq')}>FAQ</a>.
          </p>

          <div class="mt-10 flex flex-wrap -mx-4">
            <div class="w-full md:w-1/2 px-4 mb-10 md:mb-0">
              <div class="flex items-center justify-center w-12 h-12 mb-4 rounded-full border border-glass-border text-glass-white">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
                </svg>
              </div>
              <h2 class="mb-2 text-xl font-medium text-gradient font-heading">Adres lokalu</h2>
              <p class="text-glass-muted leading-loose">{CONTACT.address}</p>
              <p class="text-glass-muted leading-loose">{CONTACT.city}</p>
              <a
                href={CONTACT.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center mt-2 text-sm text-glass-accent-glow hover:text-glass-white transition-colors duration-200"
              >
                Zobacz trasę →
              </a>
            </div>

            <div class="w-full md:w-1/2 px-4">
              <div class="flex items-center justify-center w-12 h-12 mb-4 rounded-full border border-glass-border text-glass-white">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
                </svg>
              </div>
              <h2 class="mb-2 text-xl font-medium text-gradient font-heading">Kontakt</h2>
              <a href={CONTACT.emailHref}
              class="block text-glass-muted hover:text-glass-white leading-loose transition-colors duration-200">
                {CONTACT.email}
              </a>
              <a href={CONTACT.phoneHref}
              class="block text-glass-muted hover:text-glass-white leading-loose transition-colors duration-200"
              >
                {CONTACT.phone}
              </a>
            </div>
          </div>
        </div>

        <div class="w-full lg:w-1/2 px-4">
          <div class="rounded-2xl overflow-hidden">
            <MapEmbed
              title={`Mapa dojazdu do ${SITE.name}`}
              class="h-[380px]"
              iframeStyle="filter: grayscale(1) contrast(1) opacity(0.85); border:0;"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap -mx-4">

        <div class="w-full lg:w-1/2 px-4 mb-12 lg:mb-0">
          <h2 class="section-heading">Dane adresowe</h2>

          <h3 class="mb-1 text-xl font-medium text-gradient font-heading">{SITE.fullName}</h3>
          <p class="prose-p">
            {CONTACT.address}, {CONTACT.city}
          </p>

          <h3 class="mb-1 text-xl font-medium text-gradient font-heading">Godziny pracy</h3>
          <div class="flex flex-col gap-1 text-glass-muted leading-loose">
            {CONTACT.hours.map((day) => (
              <p>{day}</p>
            ))}
          </div>
        </div>

        <div class="w-full lg:w-1/2 px-4">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

---
import { getCollection } from 'astro:content';
import { resolveMedia, cloudinaryUrl } from '../utils/cloudinary';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../config/site';

// Domyślnie widoczne: pierwszy (specjalny) rząd + tyle standardowych rzędów po 3 zdjęcia.
const FIRST_ROW_COUNT = 3;
const ROW_SIZE = 3;
const INITIAL_ROWS = 3;

// Kolejność i etykiety kategorii — zgodne z listą w content.config.ts / public/admin/config.yml.
const CATEGORY_ORDER = ['Lokal', 'Wnetrza', 'Chef', 'Dania', 'Tank'];
const CATEGORY_LABELS: Record<string, string> = {
  Wnetrza: 'Wnętrza',
};

const entries = (await getCollection('gallery', (e) => e.data.published))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const items = entries.flatMap((entry) =>
  (entry.data.media ?? [])
    .filter((m) => m.file)
    .map((m) => {
      const thumb = resolveMedia(m.file, { width: 900, aspectRatio: '4:3', crop: 'fill' });
      const full = resolveMedia(m.file, { width: 1600 });
      return {
        category: entry.data.category,
        alt: m.alt || entry.data.title,
        type: thumb.type,
        thumbUrl: thumb.type === 'video' ? thumb.poster : thumb.url,
        videoUrl: thumb.type === 'video' ? full.url : null,
        posterUrl: thumb.type === 'video' ? full.poster : null,
        fullUrl: full.url,
      };
    }),
);

const categories = CATEGORY_ORDER.filter((c) => items.some((i) => i.category === c));

// Indeksy zdjęć w każdej kategorii — Alpine filtruje nimi zakładki bez przebudowy listy.
const indexByCategory = Object.fromEntries(
  categories.map((c) => [c, items.flatMap((item, i) => (item.category === c ? [i] : []))]),
);
const INITIAL_VISIBLE = FIRST_ROW_COUNT + (INITIAL_ROWS - 1) * ROW_SIZE;
---

<BaseLayout
  title="Zdjęcia restauracji nad Motławą"
  ogImage={cloudinaryUrl('riverside-dym-ogien-gdansk-galeria-otoczenie-fot-2', { width: 1200, height: 630, crop: 'fill' })}
  description="Zdjęcia i filmy z Riverside nad Motławą: taras z widokiem na Zieloną Bramę, wnętrza, bar z Pilsnerem z tanka, Chef Michał Rybak i dania z naszej kuchni."
>

  {/* Hero */}
  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h1 class="font-heading text-4xl md:text-6xl tracking-tighter text-glass-white">Zajrzyj do Riverside</h1>
        <p class="prose-p mt-8">
          Taras z widokiem na Motławę, Żuraw i Zieloną Bramę, sala z zielenią pod sufitem, bar z miedzianymi tankami
          Pilsnera Urquell, kuchnia <a href={withBase('/posts/06-chef-michal-rybak/')}>Chefa Michała Rybaka</a> i <a href={withBase('/menu')}>dania prosto z ognia</a>. Zobacz, jak wygląda Riverside. Dym i Ogień
          nad Motławą w Gdańsku.
        </p>
      </div>
    </div>
  </section>

  {items.length > 0 ? (
    <section class="pb-20">
      <div
        class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
        x-data={`{
          tab: 'Wszystkie',
          visibleRows: ${INITIAL_ROWS},
          lightbox: false,
          active: null,
          total: ${items.length},
          byCategory: ${JSON.stringify(indexByCategory)},

          get list() {
            return this.tab === 'Wszystkie' ? [...Array(this.total).keys()] : (this.byCategory[this.tab] ?? []);
          },
          get visibleCount() { return ${FIRST_ROW_COUNT} + (this.visibleRows - 1) * ${ROW_SIZE}; },
          get hasMore() { return this.list.length > this.visibleCount; },
          pos(i) { return this.list.indexOf(i); },
          isVisible(i) { const p = this.pos(i); return p >= 0 && p < this.visibleCount; },
          setTab(t) { this.tab = t; this.visibleRows = ${INITIAL_ROWS}; },
          showMore() { this.visibleRows++; },

          get activeItem() {
            if (this.active === null) return null;
            const el = this.$root.querySelector('[data-i="' + this.active + '"]');
            return el ? { ...el.dataset } : null;
          },
          get hasPrev() { return this.active !== null && this.pos(this.active) > 0; },
          get hasNext() { return this.active !== null && this.pos(this.active) < this.list.length - 1; },
          open(i) { this.active = i; this.lightbox = true; },
          close() {
            this.lightbox = false;
            this.active = null;
            this.$root.querySelectorAll('video').forEach(v => v.pause());
          },
          prev() { if (this.hasPrev) this.active = this.list[this.pos(this.active) - 1]; },
          next() { if (this.hasNext) this.active = this.list[this.pos(this.active) + 1]; },
        }`}
      >
        {/* Zakładki kategorii */}
        <div class="flex flex-wrap gap-2 md:gap-3 mb-14">
          <button
            type="button"
            x-on:click="setTab('Wszystkie')"
            x-bind:class="tab === 'Wszystkie' ? 'bg-glass-accent-amber text-glass-white border-glass-accent-amber' : 'text-glass-muted border-glass-border hover:bg-glass-accent-amber hover:text-glass-white hover:border-glass-accent-amber'"
            class="inline-block py-2.5 px-5 text-lg leading-none rounded-full transition-colors duration-200 border cursor-pointer bg-glass-accent-amber text-glass-white border-glass-accent-amber"
          >
            Wszystkie
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              x-on:click={`setTab(${JSON.stringify(cat)})`}
              x-bind:class={`tab === ${JSON.stringify(cat)} ? 'bg-glass-accent-amber text-glass-white border-glass-accent-amber' : 'text-glass-muted border-glass-border hover:bg-glass-accent-amber hover:text-glass-white hover:border-glass-accent-amber'`}
              class="inline-block py-2.5 px-5 text-lg leading-none rounded-full transition-colors duration-200 border cursor-pointer text-glass-muted border-glass-border"
            >
              {CATEGORY_LABELS[cat] ?? cat}
            </button>
          ))}
        </div>

        {/* Wszystkie zdjęcia są w HTML (widoczne dla wyszukiwarek i botów AI bez JavaScriptu).
            Alpine tylko filtruje je zakładkami i odsłania kolejne rzędy; pierwsze widoczne zdjęcie
            zajmuje na desktopie dwie kolumny i dwa rzędy. */}
        <ul class="grid gap-6 lg:grid-cols-3 lg:auto-rows-[20rem] lg:grid-flow-dense list-none p-0 m-0">
          {items.map((item, i) => (
            <li
              data-i={i}
              data-type={item.type}
              data-full={item.fullUrl}
              data-video={item.videoUrl ?? ''}
              data-poster={item.posterUrl ?? ''}
              data-alt={item.alt}
              class:list={['h-80 lg:h-auto', i === 0 && 'lg:col-span-2 lg:row-span-2']}
              x-show={`isVisible(${i})`}
              x-bind:class={`{ 'lg:col-span-2 lg:row-span-2': pos(${i}) === 0 }`}
              style={i >= INITIAL_VISIBLE ? 'display: none' : undefined}
            >
              <button
                type="button"
                class="group relative block w-full h-full rounded-3xl overflow-hidden shadow-lg shadow-black/40 ring-1 ring-glass-border transition duration-300 hover:ring-glass-accent-amber cursor-pointer"
                x-on:click={`open(${i})`}
                aria-label={`Powiększ: ${item.alt}`}
              >
                <img
                  class="block w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  src={item.thumbUrl}
                  alt={item.alt}
                  width="900"
                  height="675"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-glass-black/70 via-glass-accent-amber/10 to-transparent pointer-events-none"></div>
                <span class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                  <span class="flex items-center justify-center w-14 h-14 rounded-full bg-glass-black/50 text-glass-white">
                    {item.type === 'video' ? (
                      <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    ) : (
                      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M21 21l-4.35-4.35M11 8v6M8 11h6"/></svg>
                    )}
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        <div class="flex justify-center mt-14" x-show="hasMore" style={items.length > INITIAL_VISIBLE ? undefined : 'display: none'}>
          <button
            type="button"
            x-on:click="showMore()"
            class="group inline-flex py-5 px-8 font-medium text-glass-white hover:text-glass-black leading-none items-center justify-center border border-glass-border hover:bg-glass-accent-fire hover:border-glass-accent-fire rounded-full transition-colors duration-150 cursor-pointer"
          >
            <span class="mr-2.5">Pokaż więcej zdjęć</span>
            <span class="group-hover:rotate-45 transform transition duration-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5v11.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L7.5 13.293V1.5A.5.5 0 0 1 8 1z"/>
              </svg>
            </span>
          </button>
        </div>

        <div x-show="list.length === 0" style="display: none" class="py-20 text-center text-glass-muted">Brak zdjęć w tej kategorii.</div>

        {/* Lightbox */}
        <div
          x-show="lightbox"
          style="display: none"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-glass-black/95 p-4"
          x-on:click.self="close()"
          x-on:keydown.escape.window="close()"
          x-on:keydown.left.window="lightbox && prev()"
          x-on:keydown.right.window="lightbox && next()"
          role="dialog"
          aria-modal="true"
        >
          <button class="absolute top-4 right-4 text-glass-muted hover:text-glass-white transition-colors duration-200 cursor-pointer" x-on:click="close()" aria-label="Zamknij">
            <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>

          <button
            x-show="hasPrev"
            x-on:click="prev()"
            class="absolute left-4 top-1/2 -translate-y-1/2 text-glass-muted hover:text-glass-white transition-colors duration-200 cursor-pointer"
            aria-label="Poprzednie zdjęcie"
          >
            <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button
            x-show="hasNext"
            x-on:click="next()"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-glass-muted hover:text-glass-white transition-colors duration-200 cursor-pointer"
            aria-label="Następne zdjęcie"
          >
            <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>

          <template x-if="activeItem">
            <div class="flex flex-col items-center max-w-4xl w-full">
              <template x-if="activeItem.type === 'video'">
                <video x-bind:key="activeItem.video" x-bind:src="activeItem.video" x-bind:poster="activeItem.poster" class="max-h-[75vh] w-auto rounded-xl" controls playsinline></video>
              </template>
              <template x-if="activeItem.type !== 'video'">
                <img x-bind:key="activeItem.full" x-bind:src="activeItem.full" x-bind:alt="activeItem.alt" class="max-h-[75vh] w-auto rounded-xl object-contain" />
              </template>
              <p class="mt-4 text-glass-white font-medium text-center px-4" x-text="activeItem.alt"></p>
            </div>
          </template>
        </div>
      </div>
    </section>
  ) : (
    <section class="pb-20">
      <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-glass-muted">
        Zdjęcia i filmy pojawią się tutaj wkrótce.
      </div>
    </section>
  )}

</BaseLayout>

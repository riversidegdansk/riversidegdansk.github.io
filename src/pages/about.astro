---
import { cloudinaryVideoUrl, cloudinaryVideoPoster } from '../utils/cloudinary';
import CloudinaryImage from '../components/ui/CloudinaryImage.astro';
import { withBase } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionGallery from '../components/ui/SectionGallery.astro';
import SectionBooking from '../components/ui/SectionBooking.astro';

interface Props {
  tankImage?: string;
  chefImage?: string;
  chefVideo1?: string;
  chefVideo2?: string;
  chefVideo3?: string;
}

const {
  tankImage = 'riverside-dym-ogien-gdansk-sekcja-slider-fot-2',
  chefImage = 'riverside-dym-ogien-gdansk-chef-michal-rybak-zuraw',
  chefVideo1 = 'riverside-dym-ogien-gdansk-sekcja-video-chef-3',
  chefVideo2 = 'riverside-dym-ogien-gdansk-sekcja-video-chef-1',
  chefVideo3 = 'riverside-dym-ogien-gdansk-sekcja-video-chef-2',
} = Astro.props;

const stats = [
  { number: '01', value: '2019', suffix: '', label: 'To rok otwarcia Riverside. Dym i Ogień.' },
  { number: '02', value: '250m²', suffix: '', label: 'To powierzchnia naszych wszystkich sal.' },
  { number: '03', value: '5800', suffix: '', label: 'Tylu gości oceniło naszą restaurację.' },
  { number: '04', value: '4.6', suffix: ' ★', label: 'To ocena naszego lokalu w Google.' },
];


// Poster proponowany na 3. sekundzie — oryginalny szablon miał podpowiedź data-frame-time="3" przy każdym wideo.
const POSTER_OFFSET = 3;
const actionVideos = [chefVideo1, chefVideo2, chefVideo3].map((video) => ({
  video,
  src: video ? cloudinaryVideoUrl(video, { width: 640, aspectRatio: '9:16', crop: 'fill' }) : null,
  poster: video ? cloudinaryVideoPoster(video, { width: 640, aspectRatio: '9:16', crop: 'fill', startOffset: POSTER_OFFSET }) : null,
}));
---

<BaseLayout
  title="O nas — restauracja od 2019 roku"
  description="Riverside. Dym i Ogień nad Motławą w Gdańsku od 2019 roku: kuchnia Chefa Michała Rybaka od podstaw, Pilsner Urquell z tanka i swobodna atmosfera."
>

  {/* Intro + statystyki */}
  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap -mx-4 items-stretch">
        <div class="w-full lg:w-1/2 px-4 mb-16 lg:mb-0">
          <div class="lg:max-w-md xl:max-w-xl">
            <h1 class="font-heading text-4xl md:text-6xl mb-10 text-glass-white">O restauracji</h1>
            <p class="prose-p">Riverside działa nad Motławą, w samym sercu Gdańska, od 2019 roku. Od początku stawiamy na kuchnię opartą na jakości i przygotowywaniu dań od podstaw, bez kompromisów i półproduktów.</p>
            <p class="prose-p"><a href={withBase('/menu')}>Menu</a> tworzone przez naszego <a href={withBase('/posts/06-chef-michal-rybak/')}>Chefa Michała</a> łączy różnorodne inspiracje – od ręcznie siekanego tatara, przez ryby, pizzę, <a href={withBase('/posts/04-golonka-12-godzin/')}>golonkę</a> i <a href={withBase('/posts/05-zeberka-bbq/')}>żeberka</a>, po smaki inspirowane kuchnią azjatycką. Dopełnieniem jest niepasteryzowany Pilsner Urquell serwowany prosto z tanka.</p>
            <p class="prose-p">O wyjątkowej atmosferze Riverside decydują jednak przede wszystkim ludzie – zespół, który tworzy to miejsce każdego dnia, i goście, którzy chętnie do nas wracają. U nas zorganizujesz też <a href={withBase('/events')}>imprezę prywatną lub spotkanie firmowe</a>.</p>
          </div>
        </div>

        <div class="w-full lg:w-1/2 px-4">
          <ul class="h-full flex flex-col justify-between list-none p-0 m-0">
            {stats.map(({ number, value, suffix, label }) => (
              <li class="flex items-end justify-between pb-3 border-b border-glass-border">
                <span class="text-2xl text-glass-accent-amber">{number}</span>
                <div class="text-right">
                  <span class="block mb-1 text-2xl tracking-tight text-glass-white">
                    {value}<span class="text-glass-accent-fire">{suffix}</span>
                  </span>
                  <span class="text-glass-muted">{label}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Cytat */}
  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 md:p-16 mx-auto text-center border-t border-b border-glass-border py-16 md:py-24">
        <p class="text-xl md:text-2xl lg:text-3xl leading-snug mb-10 text-glass-muted">
          „W <span class="text-glass-accent-amber">Riverside. Dym i Ogień</span> wierzymy, że dobra restauracja to połączenie świetnej kuchni, profesjonalnej obsługi i swobodnej atmosfery.
        </p>
        <p class="text-xl md:text-2xl lg:text-3xl leading-snug text-glass-muted">
          Wierzymy, że wspólny posiłek to miejsce spotkań – na rodzinny obiad, kolację z przyjaciółmi, ważną uroczystość czy wydarzenie firmowe."
        </p>
      </div>
    </div>
  </section>

  {/* Pilsner Urquell prosto z tanka */}
  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap -mx-4 items-center">
        <div class="w-full lg:w-1/2 px-4 mb-16 lg:mb-0">
          <div class="max-w-md">
            <h2 class="section-heading lg:max-w-md">Pilsner Urquell prosto z tanka</h2>
            <p class="prose-p mt-10">W 2019 roku jako pierwszy lokal na Pomorzu zaczęliśmy serwować niepasteryzowanego <a href={withBase('/posts/01-piwo-z-tanka-jak-to-dziala/')}>Pilsnera Urquell prosto z tanka</a> – świeżego, niefiltrowanego i zawsze w idealnej temperaturze.</p>
            <p class="prose-p">Bo wierzymy, że dbałość o jakość nie kończy się na kuchni. Dlatego równie dużą wagę przykładamy do tego, co trafia do kufla. Piwo z tanka nie jest u nas atrakcją – jest standardem.</p>
          </div>
        </div>
        <div class="w-full lg:w-1/2 px-4">
          {tankImage ? (
            <div class="relative rounded-3xl overflow-hidden shadow-2xl">
              <CloudinaryImage publicId={tankImage} preset="section" class="block w-full rounded-3xl" />
            </div>
          ) : (
            <CloudinaryImage preset="section" placeholderClass="rounded-3xl" />
          )}
        </div>
      </div>
    </div>
  </section>

  {/* Chef Michał Rybak */}
  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap -mx-4 items-center">
        <div class="w-full lg:w-1/2 px-4 mb-12 lg:mb-0">
          {chefImage ? (
            <div class="rounded-3xl overflow-hidden">
              <CloudinaryImage publicId={chefImage} alt="Michał Rybak" preset="section" class="block w-full rounded-3xl" />
            </div>
          ) : (
            <CloudinaryImage preset="section" placeholderClass="rounded-3xl" />
          )}
        </div>
        <div class="w-full lg:w-1/2 px-4">
          <div class="max-w-lg mx-auto">
            <h2 class="section-heading">Chef Michał Rybak</h2>
            <p class="prose-p">
              Za smakiem Riverside stoi Michał Rybak – szef kuchni, którego możecie znać także z TikToka i profilu <span class="text-glass-accent-amber">@rybalikeachef</span>. Michał łączy doświadczenie, wiedzę i otwartość na różne kulinarne inspiracje.
            </p>
            <p class="prose-p">W jego podejściu nie ma miejsca na półprodukty ani skróty. Każde danie powstaje od podstaw, a smaki są budowane tak, by zaskakiwać, ale zawsze pozostać zrozumiałe i autentyczne.</p>
            <p class="prose-p">Dzięki temu obok sprawdzonych dań, do których goście regularnie wracają, pojawiają się nowe kompozycje inspirowane aktualnymi produktami i kulinarnymi odkryciami.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Chef @rybalikeachef w akcji */}
  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-20">Chef <span class="text-glass-accent-amber">@rybalikeachef</span> w akcji</h2>

      <div class="flex flex-wrap -mx-4">
        {actionVideos.map(({ video, src, poster }) => (
          <div class="w-full lg:w-1/3 px-4 mb-8 lg:mb-0">
            <div class="flex items-center justify-center max-w-md mx-auto lg:max-w-none p-4 rounded-3xl shadow-lg">
              {video ? (
                <video
                  class="block w-full aspect-[9/16] max-w-sm object-contain rounded-3xl"
                  controls
                  playsinline
                  preload="metadata"
                  poster={poster}
                >
                  <source src={src} type="video/mp4" />
                  Twoja przeglądarka nie obsługuje odtwarzania wideo.
                </video>
              ) : (
                <div class="flex w-full aspect-[9/16] max-w-sm items-center justify-center bg-glass-anthracite border border-glass-border rounded-3xl" role="img" aria-label="Wideo wkrótce">
                  <svg class="w-14 h-14 text-glass-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 6.82v10.36a1 1 0 0 0 1.5.87l9-5.18a1 1 0 0 0 0-1.74l-9-5.18A1 1 0 0 0 8 6.82z"/>
                  </svg>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionGallery />

  <SectionBooking />

</BaseLayout>

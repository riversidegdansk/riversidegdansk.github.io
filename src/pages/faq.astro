---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqAnswerHtml, faqAnswerText } from '../utils/faq';
import { getLivePosts } from '../utils/posts';

const faqs = await getCollection('faq');
const livePostIds = new Set((await getLivePosts()).map((post) => post.id));
const sorted = faqs.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sorted.map((faq) => ({
    '@type': 'Question',
    name: faq.data.question,
    acceptedAnswer: { '@type': 'Answer', text: faqAnswerText(faq.data.answer) },
  })),
};
---

<BaseLayout
  title="FAQ — rezerwacje, menu i imprezy"
  description="Odpowiedzi na najczęstsze pytania o rezerwację stolika, godziny otwarcia, menu, piwo z tanka i organizację imprez w Riverside w Gdańsku."
  jsonLd={jsonLd}
>

  <section class="section-py">
    <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-12 text-center">
        <h1 class="mt-2 section-heading">FAQ — najczęściej zadawane pytania</h1>
      </div>

      <div class="max-w-4xl mx-auto">
        <ul class="border-y border-glass-border divide-y divide-glass-border">
          {sorted.map((faq, i) => (
            <li x-data={`{ open: ${i === 0} }`}>
              <button
                class="group w-full py-7 flex justify-between items-center gap-4 text-left cursor-pointer"
                x-on:click="open = !open"
                x-bind:aria-expanded="open.toString()"
              >
                <h2
                  class="text-xl font-heading transition-colors duration-200"
                  x-bind:class="open ? 'text-glass-accent-amber' : 'text-glass-white group-hover:text-glass-accent-amber'"
                >
                  {faq.data.question}
                </h2>
                <span
                  class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-full border border-glass-accent-amber/60 text-glass-accent-amber text-xl leading-none"
                  x-text="open ? '−' : '+'"
                  aria-hidden="true"
                >{i === 0 ? '−' : '+'}</span>
              </button>

              <div
                x-show="open"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 -translate-y-2"
                x-transition:enter-end="opacity-100 translate-y-0"
                x-transition:leave="transition ease-in duration-200"
                x-transition:leave-start="opacity-100 translate-y-0"
                x-transition:leave-end="opacity-0 -translate-y-2"
                class="pb-7 -mt-3"
              >
                <p class="prose-p max-w-2xl" set:html={faqAnswerHtml(faq.data.answer, livePostIds)} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>